<Window x:Class="LANType.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LANType.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LANType — Virtual HID Keyboard Control Panel" 
        Icon="pack://application:,,,/LANType.Desktop;component/Assets/app.ico"
        Height="800" Width="1100"
        MinHeight="660" MinWidth="920"
        Background="#09090B"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI Variable Display, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Standard Zinc Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <!-- Primary High-Contrast White Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#09090B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E4E4E7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#D4D4D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Zinc Elevated Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2E2E33" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#18181B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#18181B" />
                                <Setter Property="Foreground" Value="#71717A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Red Button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Caption Window Buttons -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="capBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="capBorder" Property="Background" Value="#DC2626" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with 1px hairline boundary -->
    <Border BorderBrush="#2E2E33" BorderThickness="1" Background="#09090B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />  <!-- Custom Sleek Dark Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Sub-header / Top Bar -->
                <RowDefinition Height="*" />    <!-- Main Tabs Content -->
                <RowDefinition Height="Auto" /> <!-- Minimal Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Themed Dark Title Bar -->
            <Grid Grid.Row="0" Background="#09090B" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border CornerRadius="4" Width="20" Height="20" ClipToBounds="True" Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/LANType.Desktop;component/Assets/logo.png" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="LANType" FontWeight="Bold" FontSize="13" Foreground="#FAFAFA" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="— Control Panel" FontSize="12" Foreground="#71717A" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Drag region -->
                <Grid Grid.Column="1" Background="Transparent" />

                <!-- Right: Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" />
                    <Button Content="□" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 2. Sub-Header: Branding & Real-time Live Status Indicators -->
            <Border Grid.Row="1" Background="#09090B" BorderBrush="#2E2E33" BorderThickness="0,1,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Hardware Keyboard Emulation Stack" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                            <TextBlock Text="Virtual HID Framework (VHF) engine and encrypted LAN streaming protocol" FontSize="12" Foreground="#71717A" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Minimal Status Indicators (Matching Android App) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Service Status -->
                        <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding ServiceStatusColor}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ServiceStatusText}" FontSize="11" FontWeight="Medium" Foreground="#FAFAFA" />
                            </StackPanel>
                        </Border>

                        <!-- Driver Status -->
                        <Border Background="#18181B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding DriverStatusColor}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DriverStatusText}" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" />
                            </StackPanel>
                        </Border>

                        <!-- Refresh Action Button -->
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" 
                                Command="{Binding RefreshStatusCommand}" Padding="10,4" FontSize="11"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Content with Tabs -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="14,6,14,10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Foreground" Value="#71717A" />
                        <Setter Property="Padding" Value="14,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="tabBorder" Background="Transparent" 
                                            BorderBrush="Transparent" BorderThickness="0,0,0,2" 
                                            Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="#FAFAFA" />
                                            <Setter Property="Foreground" Value="#FAFAFA" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FAFAFA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: Dashboard & Live Session -->
                <TabItem Header="Dashboard">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Pairing & Hotspot Card -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Phone Pairing" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,4" />
                                <TextBlock Text="Connect your Android phone to laptop Wi-Fi hotspot and scan QR code:" 
                                           FontSize="12" Foreground="#71717A" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <!-- QR Code Box with Clean Border -->
                                <Border Background="#FFFFFF" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <Image Source="{Binding QrCodeImage}" Width="180" Height="180" Stretch="Uniform" />
                                </Border>

                                <!-- 6-digit PIN Box (Clean Minimalist Black) -->
                                <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="PAIRING PIN" FontSize="10" FontWeight="SemiBold" Foreground="#71717A" />
                                            <TextBlock Text="{Binding PairingPin}" FontSize="26" FontWeight="Bold" 
                                                       Foreground="#FAFAFA" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Content="Regenerate" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding RegeneratePinCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Endpoint Info Table -->
                                <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Host Address" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding HostIpAddress}" HorizontalAlignment="Right" FontWeight="Medium" Foreground="#FAFAFA" FontSize="12" />
                                        </Grid>

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="WebSocket Port" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding WebSocketPort}" HorizontalAlignment="Right" FontWeight="Medium" Foreground="#FAFAFA" FontSize="12" />
                                        </Grid>

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Paired Device" Foreground="#71717A" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding PairedDeviceName}" HorizontalAlignment="Right" FontWeight="Medium" Foreground="#FAFAFA" FontSize="12" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Column: Typing Progress & Controls -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Telemetry Card -->
                            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Typing Telemetry" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <Border HorizontalAlignment="Right" Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding StateBadgeColor}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StateBadgeText}" FontSize="11" FontWeight="Medium" Foreground="#FAFAFA" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Progress Bar (Clean Minimal Line) -->
                                    <Grid Margin="0,4,0,8">
                                        <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" 
                                                     Foreground="#FFFFFF" Background="#27272A" BorderThickness="0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F1}% Completed}" 
                                                   FontSize="12" FontWeight="Medium" Foreground="#A1A1AA" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#71717A">
                                            <Run Text="{Binding CharactersTyped}" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <Run Text=" of " />
                                            <Run Text="{Binding TotalCharacters}" Foreground="#FAFAFA" />
                                            <Run Text=" chars" />
                                        </TextBlock>
                                    </Grid>

                                    <!-- Metrics Grid (Pure Black Backgrounds with Subtle Borders) -->
                                    <UniformGrid Columns="4" Margin="0,0,0,14">
                                        <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="SPEED" FontSize="10" Foreground="#71717A" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentCpm, StringFormat={}{0} CPM}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="WORDS" FontSize="10" Foreground="#71717A" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentWpm, StringFormat={}{0} WPM}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="REMAINING" FontSize="10" Foreground="#71717A" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EstimatedRemainingText}" FontSize="18" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="ELAPSED" FontSize="10" Foreground="#71717A" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ElapsedTimeText}" FontSize="18" FontWeight="Bold" Foreground="#A1A1AA" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Pause" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding PauseTypingCommand}" Margin="0,0,6,0" />
                                        <Button Content="Resume" Style="{StaticResource PrimaryButton}" 
                                                Command="{Binding ResumeTypingCommand}" Margin="0,0,6,0" />
                                        <Button Content="Stop" Style="{StaticResource SecondaryButton}" 
                                                Command="{Binding StopTypingCommand}" Margin="0,0,6,0" />
                                        <Button Content="🚨 Killswitch" Style="{StaticResource DangerButton}" 
                                                Command="{Binding EmergencyStopCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Architectural State Verification Card -->
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Architectural State" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,10" />
                                    
                                    <BulletDecorator Margin="0,3">
                                        <BulletDecorator.Bullet><Ellipse Width="5" Height="5" Fill="#A1A1AA" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                        <TextBlock Text="Control Panel GUI connects to background service via local HTTP IPC and operates independently." FontSize="12" Foreground="#A1A1AA" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,3">
                                        <BulletDecorator.Bullet><Ellipse Width="5" Height="5" Fill="#A1A1AA" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                        <TextBlock Text="Keystrokes are submitted through genuine Windows Virtual HID Framework (VHF), bypassing clipboard and simulated API hooks." FontSize="12" Foreground="#A1A1AA" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,3">
                                        <BulletDecorator.Bullet><Ellipse Width="5" Height="5" Fill="#A1A1AA" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                        <TextBlock Text="Zero residual key-state: all modifier keys and HID scancodes are automatically released upon pause or stop." FontSize="12" Foreground="#A1A1AA" />
                                    </BulletDecorator>

                                    <BulletDecorator Margin="0,3">
                                        <BulletDecorator.Bullet><Ellipse Width="5" Height="5" Fill="#A1A1AA" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                        <TextBlock Text="Zero persistent payload storage: text buffers are handled solely in memory and never written to disk." FontSize="12" Foreground="#A1A1AA" />
                                    </BulletDecorator>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Manual Direct Typing Test -->
                <TabItem Header="Manual Typing Test">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Direct Local Typing Test" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,4" />
                                <TextBlock Text="Test the typing speed scheduler and HID report transmission directly from Windows without requiring a phone connection." 
                                           FontSize="12" Foreground="#71717A" Margin="0,0,0,14" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Typing Speed:" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Medium" Foreground="#FAFAFA" FontSize="12" />
                                    <Slider Grid.Column="1" Minimum="60" Maximum="1200" Value="{Binding ManualSpeedCpm}" 
                                            TickFrequency="60" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ManualSpeedCpm, StringFormat={}{0} CPM}" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FAFAFA" FontSize="13" />
                                </Grid>
                            </StackPanel>

                            <!-- Text Editor Box (Pure Black Zinc with Hairline Border) -->
                            <Border Grid.Row="1" Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <TextBox Text="{Binding ManualTestText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" Foreground="#FAFAFA" BorderThickness="0" 
                                         AcceptsReturn="True" TextWrapping="Wrap" FontSize="13" 
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <!-- Controls -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Click Start, then switch to CodeTantra / Kiosk editor and click inside within 5 seconds." 
                                           VerticalAlignment="Center" Foreground="#71717A" FontSize="12" Margin="0,0,14,0" />
                                <Button Content="▶ Start Typing (5s countdown)" Style="{StaticResource PrimaryButton}" 
                                        Command="{Binding StartManualTypingCommand}" Padding="16,9" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 3: Driver & Diagnostics -->
                <TabItem Header="Driver &amp; Diagnostics">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Driver Status and Instructions -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Virtual HID Driver Status" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,8" />
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Active Driver Stack: " FontWeight="Medium" Foreground="#71717A" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding DriverStatusText}" FontWeight="SemiBold" Foreground="{Binding DriverStatusColor}" FontSize="12" />
                                </Grid>

                                <TextBlock Text="To install the KMDF Virtual HID Keyboard driver with test signing:" 
                                           FontWeight="Medium" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,6" />
                                
                                <Border Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <TextBlock Text="1. Enable test mode (Admin):  bcdedit /set testsigning on&#x0a;2. Reboot PC&#x0a;3. Install driver: pnputil /add-driver windows\hid-driver\LANTypeVhid.inf /install&#x0a;4. Verify 'LANType Virtual HID Keyboard Device' under Keyboards in Windows Device Manager." 
                                               FontFamily="Consolas" FontSize="12" Foreground="#FAFAFA" TextWrapping="Wrap" />
                                </Border>

                                <Button Content="⚙ Register / Install Kernel Driver" Style="{StaticResource SecondaryButton}" 
                                        Command="{Binding RegisterDriverCommand}" HorizontalAlignment="Left" Padding="14,8" />
                            </StackPanel>
                        </Border>

                        <!-- Realtime Diagnostic Logs -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Diagnostic Event Logs" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,8" />
                                <Border Grid.Row="1" Background="#09090B" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <TextBox Text="{Binding TroubleshootingLogs}" Background="Transparent" Foreground="#A1A1AA" 
                                             BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" 
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 4. Footer Bar -->
            <Border Grid.Row="3" Background="#09090B" BorderBrush="#2E2E33" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <TextBlock Text="LANType Protocol v1.0 • Service: C:\Program Files\LANType\Service • Logs: C:\ProgramData\LANType\logs" 
                               FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" Text="Kiosk &amp; Enterprise Desktop Compatible • Genuine VHF Architecture" 
                               FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
