<Window x:Class="LANType.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LANType.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LANType — Virtual HID Keyboard Control Panel" 
        Height="780" Width="1080"
        MinHeight="650" MinWidth="900"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="8" />
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#991B1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="Assets/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="LANType" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="System-Wide Virtual HID Keyboard Typing System" FontSize="12" Foreground="#94A3B8" />
                    </StackPanel>
                </StackPanel>

                <!-- Quick Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding ServiceStatusColor}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ServiceStatusText}" FontSize="12" Foreground="#E2E8F0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding DriverStatusColor}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DriverStatusText}" FontSize="12" Foreground="#E2E8F0" />
                        </StackPanel>
                    </Border>

                    <Button Content="Refresh" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding RefreshStatusCommand}" Padding="10,4" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,8">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <Setter Property="Padding" Value="16,10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder" Background="Transparent" 
                                        BorderBrush="Transparent" BorderThickness="0,0,0,3" 
                                        Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="#60A5FA" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#F8FAFC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Dashboard & Live Session -->
            <TabItem Header="Dashboard">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Pairing & Hotspot Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="📱 Phone Pairing &amp; Network" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                            <TextBlock Text="Connect phone to laptop hotspot or Wi-Fi, then scan QR code:" 
                                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- QR Code Box -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Image Source="{Binding QrCodeImage}" Width="190" Height="190" Stretch="Uniform" />
                            </Border>

                            <!-- 6-digit PIN Box -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="MANUAL PAIRING PIN" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="{Binding PairingPin}" FontSize="28" FontWeight="Bold" 
                                                   Foreground="#38BDF8" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Content="Regenerate" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding RegeneratePinCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Endpoint Info -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Host Address:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding HostIpAddress}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="WebSocket Port:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding WebSocketPort}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connected Device:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding PairedDeviceName}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#10B981" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Typing Progress & Controls -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Telemetry Card -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="⚡ Real-Time Typing Telemetry" FontSize="16" FontWeight="Bold" />
                                    <Border HorizontalAlignment="Right" Background="#0F172A" CornerRadius="12" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StateBadgeColor}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding StateBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Progress Bar -->
                                <Grid Margin="0,6,0,12">
                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="14" 
                                                 Foreground="#3B82F6" Background="#0F172A" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0:F1}% Completed}" 
                                               FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#94A3B8">
                                        <Run Text="{Binding CharactersTyped}" FontWeight="Bold" Foreground="#F8FAFC" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalCharacters}" />
                                        <Run Text=" chars" />
                                    </TextBlock>
                                </Grid>

                                <!-- Metrics Grid -->
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="SPEED (CPM)" FontSize="10" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CurrentCpm}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="SPEED (WPM)" FontSize="10" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CurrentWpm}" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="REMAINING" FontSize="10" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding EstimatedRemainingText}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="4">
                                        <StackPanel>
                                            <TextBlock Text="ELAPSED" FontSize="10" Foreground="#64748B" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ElapsedTimeText}" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Content="⏸ Pause" Style="{StaticResource SecondaryButton}" 
                                            Command="{Binding PauseTypingCommand}" Margin="0,0,8,0" />
                                    <Button Content="▶ Resume" Style="{StaticResource ModernButton}" 
                                            Command="{Binding ResumeTypingCommand}" Margin="0,0,8,0" />
                                    <Button Content="⏹ Stop" Style="{StaticResource DangerButton}" 
                                            Command="{Binding StopTypingCommand}" Margin="0,0,8,0" />
                                    <Button Content="🚨 EMERGENCY KILLSWITCH" Style="{StaticResource DangerButton}" 
                                            Command="{Binding EmergencyStopCommand}" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- System Overview Info Card -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="🛡️ Architectural State Verification" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                                <TextBlock Text="Conforming to LANType project specifications:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8" />
                                
                                <BulletDecorator Margin="0,3">
                                    <BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                    <TextBlock Text="Control Panel window operates independently of the background service process." FontSize="12" Foreground="#CBD5E1" />
                                </BulletDecorator>

                                <BulletDecorator Margin="0,3">
                                    <BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                    <TextBlock Text="Keystrokes are submitted through Windows Virtual HID Framework (VHF), not SendInput or clipboard paste." FontSize="12" Foreground="#CBD5E1" />
                                </BulletDecorator>

                                <BulletDecorator Margin="0,3">
                                    <BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                    <TextBlock Text="Safe key-state release is guaranteed upon pause, cancellation, disconnect, or emergency stop." FontSize="12" Foreground="#CBD5E1" />
                                </BulletDecorator>

                                <BulletDecorator Margin="0,3">
                                    <BulletDecorator.Bullet><Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,6,8,0" /></BulletDecorator.Bullet>
                                    <TextBlock Text="Sensitive user text is processed in memory and never logged to diagnostic log files." FontSize="12" Foreground="#CBD5E1" />
                                </BulletDecorator>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Manual Direct Typing Test -->
            <TabItem Header="Manual Typing Test">
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="⌨️ Direct Local Typing Test" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Test the typing speed scheduler and HID report transmission directly from Windows without requiring a phone connection." 
                                       FontSize="12" Foreground="#94A3B8" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Typing Speed (CPM):" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" />
                                <Slider Grid.Column="1" Minimum="60" Maximum="1200" Value="{Binding ManualSpeedCpm}" 
                                        TickFrequency="60" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ManualSpeedCpm, StringFormat={}{0} CPM}" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38BDF8" />
                            </Grid>
                        </StackPanel>

                        <!-- Text Editor -->
                        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBox Text="{Binding ManualTestText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" 
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="14" 
                                     VerticalScrollBarVisibility="Auto" />
                        </Border>

                        <!-- Controls -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Click Start, then focus Notepad or any target window within 3 seconds." 
                                       VerticalAlignment="Center" Foreground="#F59E0B" FontSize="12" Margin="0,0,16,0" />
                            <Button Content="▶ Start Typing (3s countdown)" Style="{StaticResource ModernButton}" 
                                    Command="{Binding StartManualTypingCommand}" Padding="16,10" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: Driver & Troubleshooting -->
            <TabItem Header="Driver &amp; Diagnostics">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Driver Status and Instructions -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🔧 Virtual HID Driver Installation &amp; Status" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current Driver Status: " FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding DriverStatusText}" FontWeight="Bold" Foreground="{Binding DriverStatusColor}" />
                            </Grid>

                            <TextBlock Text="To install the KMDF Virtual HID Keyboard driver with test signing:" 
                                       FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6" />
                            
                            <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <TextBlock Text="1. Enable test mode (Admin):  bcdedit /set testsigning on&#x0a;2. Reboot PC&#x0a;3. Install driver: pnputil /add-driver windows\hid-driver\LANTypeVhid.inf /install&#x0a;4. Verify 'LANType Virtual HID Keyboard Device' under Keyboards in Windows Device Manager." 
                                           FontFamily="Consolas" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Realtime Diagnostic Logs -->
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📋 Diagnostic Event Logs" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="10">
                                <TextBox Text="{Binding TroubleshootingLogs}" Background="Transparent" Foreground="#94A3B8" 
                                         BorderThickness="0" FontFamily="Consolas" FontSize="11" IsReadOnly="True" 
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <TextBlock Text="LANType Protocol v1.0 • Service: C:\Program Files\LANType\Service • Logs: C:\ProgramData\LANType\logs" 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" Text="Kiosk &amp; Desktop Compatible • Genuine HID Architecture" 
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
